#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define BAS_L 0
#define NAV_L 1

/ {
    combos {
        compatible = "zmk,combos";

        bootloader_combo {
            bindings = <&bootloader>;
            key-positions = <13 28 60 54>;
            timeout-ms = <150>;
        };

        sys_reset_combo {
            bindings = <&sys_reset>;
            key-positions = <28 60 54>;
            timeout-ms = <150>;
        };
    };

    macros {
        // TEMPORARY TEST: cut ext-power (P0.31) for 5 seconds, then turn it back on,
        // to see what it controls. Ends with EP_ON so the saved state is never left off.
        ext_power_test: ext_power_test {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_wait_time 5000>, <&ext_power EP_OFF>, <&macro_wait_time 0>, <&ext_power EP_ON>;
        };
    };

    behaviors {
        func_layer_tapdace: func_layer_tapdace {
            compatible = "zmk,behavior-tap-dance";
            label = "FUNC_LAYER_TAPDACE";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&tog 1>;
        };

        ctrl_layer_tapdace: ctrl_layer_tapdace {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_LAYER_TAPDACE";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 2>;
        };

        sys_layer_tapdace: sys_layer_tapdace {
            compatible = "zmk,behavior-tap-dance";
            label = "SYS_LAYER_TAPDACE";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&tog 3>;
        };

        bksp_del_modmorph: bksp_del_modmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "BKSP_DEL_MODMORPH";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        caps_modmorph: caps_modmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPS_MODMORPH";
            bindings = <&func_layer_tapdace>, <&kp CAPSLOCK>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------
            // | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BKSP   |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   "|"   |
            // | CAPS  |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER    |
            // |  SHIFT  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |      SHIFT       |
            // |  CTL  |  WIN  |  ALT  |            SPACE              |  ALT  |  WIN  |  MO(1) |  CTL  |
            // ------------------------------------------------------------------------------------------

            label = "Base";
            bindings = <
&gresc          &kp N1    &kp N2  &kp N3    &kp N4  &kp N5  &kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS  &kp EQUAL            &bksp_del_modmorph
&kp TAB         &kp Q     &kp W   &kp E     &kp R   &kp T   &kp Y      &kp U   &kp I      &kp O    &kp P     &kp LBKT   &kp RBKT             &kp BSLH
&caps_modmorph  &kp A     &kp S   &kp D     &kp F   &kp G   &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT                         &kp RET
&kp LSHFT       &kp Z     &kp X   &kp C     &kp V   &kp B   &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH                                  &kp RSHFT
&kp LCTRL       &kp LGUI          &kp LALT                  &kp SPACE                              &kp RALT  &kp RGUI   &func_layer_tapdace  &kp RCTRL
            >;
        };

        function_layer {
            // ------------------------------------------------------------------------------------------------
            // | BT CLR | F1  | F2  | F3  | F4  | F5  | F6  | F7  | F8  | F9  | F10  | F11 | F12 |            |
            // |  BT 1   |   |  UP |   |       |       |       |       |   |     |    |     |     |           |
            // |   BT 2   | LT |  DN  | RT |       |       |       |       |   |     |   |     |              |
            // |    BT 3     |     |      |      |     |     |     |     |     |     |     |                  |
            // |   BT 4  |      |      |                                    | PRT SCR |       |       |  DEL  |
            // ------------------------------------------------------------------------------------------------

            label = "Function";
            bindings = <
&to 0   &kp F1    &kp F2    &kp F3     &kp F4      &kp F5  &kp F6    &kp F7         &kp F8       &kp F9     &kp F10    &kp F11             &kp F12  &trans
&trans  &kp HOME  &kp UP    &kp END    &trans      &trans  &trans    &trans         &trans       &trans     &trans     &trans              &trans   &trans
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans      &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans     &kp GRAVE                    &trans
&trans  &trans    &trans    &trans     &kp INSERT  &trans  &trans    &trans         &trans       &kp TILDE  &trans                                  &trans
&trans  &trans              &trans                         &trans                                           &kp PSCRN  &sys_layer_tapdace  &trans   &ctrl_layer_tapdace
            >;
        };

        control_layer {
            bindings = <
&to 0   &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans      &trans  &trans  &trans    &trans  &trans  &trans  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&trans  &trans                &trans                &trans      &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans             &trans           &trans
&trans  &kp C_PREVIOUS        &kp C_PP              &kp C_NEXT  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans                              &trans
&trans  &trans                &trans                &trans      &trans  &trans  &trans    &trans  &trans  &trans  &trans                                          &trans
&trans  &trans                                      &trans                      &kp C_PP                          &trans      &trans             &trans           &trans
            >;

            label = "Control";
        };

        system_layer {
            bindings = <
&to 0   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &bt BT_CLR  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans      &trans          &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans                      &trans
&ext_power_test  &trans                      &trans                                    &trans                          &trans      &trans  &trans  &trans
            >;

            label = "System";
        };
    };
};
