#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        // Press all four keys together (within 150 ms), on any layer:
        //   Caps + LShift + RAlt + Bksp  -> bootloader (flash mode)
        //   Caps + LShift + RAlt + Esc   -> sys reset (restart the keyboard)
        bootloader_combo {
            bindings = <&bootloader>;
            key-positions = <13 41 28 57>;
            timeout-ms = <150>;
        };

        sys_reset_combo {
            bindings = <&sys_reset>;
            key-positions = <28 41 57 0>;
            timeout-ms = <150>;
        };
    };

    behaviors {
        // Layer keys: hold for the layer while pressed, double-tap to toggle it on and off.
        func_layer_tapdace: func_layer_tapdace {
            compatible = "zmk,behavior-tap-dance";
            label = "FUNC_LAYER_TAPDACE";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&tog 1>;
        };

        ctrl_layer_tapdace: ctrl_layer_tapdace {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_LAYER_TAPDACE";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 2>;
        };

        sys_layer_tapdace: sys_layer_tapdace {
            compatible = "zmk,behavior-tap-dance";
            label = "SYS_LAYER_TAPDACE";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&tog 3>;
        };

        // Right Shift turns Backspace into Delete, and the Caps/Fn key into Caps Lock.
        bksp_del_modmorph: bksp_del_modmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "BKSP_DEL_MODMORPH";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        caps_modmorph: caps_modmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPS_MODMORPH";
            bindings = <&func_layer_tapdace>, <&kp CAPSLOCK>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------------------------------
            // |  Esc  |   1   |   2   |   3   |   4   |   5   |   6   |   7   |   8   |   9   |   0   |   -   |   =   | Bksp  |
            // |  Tab  |   Q   |   W   |   E   |   R   |   T   |   Y   |   U   |   I   |   O   |   P   |   [   |   ]   |   \   |
            // | Caps/Fn |   A   |   S   |   D   |   F   |   G   |   H   |   J   |   K   |   L   |   ;   |   '   | Enter |
            // | LShift |   Z   |   X   |   C   |   V   |   B   |   N   |   M   |   ,   |   .   |   /   | RShift |
            // | LCtrl | LGui  | LAlt  | Space | RAlt  | RGui  |  Fn   | RCtrl |
            // -----------------------------------------------------------------------------------------------------------------
            // Esc: Shift or Gui + Esc gives ` and ~ (gresc). Bksp: with Right Shift it is Delete.
            // Caps/Fn: hold for the Function layer, double-tap to toggle it; Right Shift + it is Caps Lock.
            // Fn: hold for the Function layer, double-tap to toggle it.

            label = "Base";
            bindings = <
&gresc          &kp N1    &kp N2  &kp N3    &kp N4  &kp N5  &kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS  &kp EQUAL            &bksp_del_modmorph
&kp TAB         &kp Q     &kp W   &kp E     &kp R   &kp T   &kp Y      &kp U   &kp I      &kp O    &kp P     &kp LBKT   &kp RBKT             &kp BSLH
&caps_modmorph  &kp A     &kp S   &kp D     &kp F   &kp G   &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT                         &kp RET
&kp LSHFT       &kp Z     &kp X   &kp C     &kp V   &kp B   &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH                                  &kp RSHFT
&kp LCTRL       &kp LGUI          &kp LALT                  &kp SPACE                              &kp RALT  &kp RGUI   &func_layer_tapdace  &kp RCTRL
            >;
        };

        function_layer {
            // -----------------------------------------------------------------------------------------------------------------
            // | Base  |  F1   |  F2   |  F3   |  F4   |  F5   |  F6   |  F7   |  F8   |  F9   |  F10  |  F11  |  F12  |  __   |
            // |  __   | Home  |  Up   |  End  |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |
            // |  __   | Left  | Down  | Right |  __   |  __   | Home  | PgDn  | PgUp  |  End  |  __   |   `   |  __   |
            // |  __   |  __   |  __   |  __   |  Ins  |  __   |  __   |  __   |  __   |   ~   |  __   |  __   |
            // |  __   |  __   |  __   |  __   | PrtSc |  Sys  |  __   | Ctrl  |
            // -----------------------------------------------------------------------------------------------------------------
            // __ passes the key through to the Base layer. Sys and Ctrl: hold to use that layer, double-tap to toggle it.
            // Reach this layer with Fn or Caps/Fn; Base (top-left) returns to the Base layer.

            label = "Function";
            bindings = <
&to 0   &kp F1    &kp F2    &kp F3     &kp F4      &kp F5  &kp F6    &kp F7         &kp F8       &kp F9     &kp F10    &kp F11             &kp F12  &trans
&trans  &kp HOME  &kp UP    &kp END    &trans      &trans  &trans    &trans         &trans       &trans     &trans     &trans              &trans   &trans
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans      &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans     &kp GRAVE                    &trans
&trans  &trans    &trans    &trans     &kp INSERT  &trans  &trans    &trans         &trans       &kp TILDE  &trans                                  &trans
&trans  &trans              &trans                         &trans                                           &kp PSCRN  &sys_layer_tapdace  &trans   &ctrl_layer_tapdace
            >;
        };

        control_layer {
            // -----------------------------------------------------------------------------------------------------------------
            // | Base  | Bri-  | Bri+  |  __   |  __   |  __   |  __   |  __   |  __   |  __   | Mute  | Vol-  | Vol+  |  __   |
            // |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |
            // |  __   | Prev  | Play  | Next  |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |
            // |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |
            // |  __   |  __   |  __   | Play  |  __   |  __   |  __   |  __   |
            // -----------------------------------------------------------------------------------------------------------------
            // Reach this layer by holding Fn, then holding Ctrl (bottom-right). Base (top-left) returns to the Base layer.

            bindings = <
&to 0   &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans      &trans  &trans  &trans    &trans  &trans  &trans  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&trans  &trans                &trans                &trans      &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans             &trans           &trans
&trans  &kp C_PREVIOUS        &kp C_PP              &kp C_NEXT  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans                              &trans
&trans  &trans                &trans                &trans      &trans  &trans  &trans    &trans  &trans  &trans  &trans                                          &trans
&trans  &trans                                      &trans                      &kp C_PP                          &trans      &trans             &trans           &trans
            >;

            label = "Control";
        };

        system_layer {
            // -----------------------------------------------------------------------------------------------------------------
            // | Base  |  BT0  |  BT1  |  BT2  |  BT3  |  BT4  |  __   |  __   |  __   |  __   | BtClr |  __   |  __   |  __   |
            // |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |
            // |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |
            // |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |
            // |  __   |  __   |  __   |  __   |  __   |  __   |  __   |  __   |
            // -----------------------------------------------------------------------------------------------------------------
            // Reach this layer by holding Fn, then holding Sys (bottom row, where Right Gui is). Base (top-left) returns to Base.
            // BT0 to BT4 select Bluetooth profiles 0 to 4 (profile 0 = 1 blue LED flash, 1 = 2 flashes, ...). BtClr clears the current profile's pairing.

            bindings = <
&to 0   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &bt BT_CLR  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans      &trans          &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans                      &trans
&trans  &trans                      &trans                                    &trans                          &trans      &trans  &trans  &trans
            >;

            label = "System";
        };
    };
};
